<mxfile host="drawio"><diagram name="2.2_interfaces_usuario"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="2.2 Interfaces de usuario — Tolotolo Gym (capturas de la aplicación)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1450" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Todas las vistas cargan la misma hoja estilos.css y usan sus clases (cabecera, recuadro-titulo, boton, campo, panel, lista...); ninguna lleva estilos en línea." style="text;html=1;fontSize=12;fontColor=#555555;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="32" width="1450" height="20" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="450" height="300" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Login.fxml&lt;/b&gt; — Inicio de sesión: correo y contraseña; enlace a registro" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="364" width="450" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="450" height="300" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Register.fxml&lt;/b&gt; — Registro de cliente: datos personales, membresía y pago" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="364" width="450" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="450" height="300" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Cliente.fxml&lt;/b&gt; — Panel del cliente: sus clases (máx. 6), más clases, datos y logros" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="364" width="450" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="450" height="300" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Gerente.fxml&lt;/b&gt; — Panel del gerente: menús, clases, clientes, monitores y ver log" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="744" width="450" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="450" height="300" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Monitor.fxml&lt;/b&gt; — Panel del monitor: menús, clases y clientes" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="744" width="450" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="450" height="300" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GestorClase.fxml&lt;/b&gt; — Gestión de clases (crear con su primera franja, borrar) y de sus sesiones; menú contextual en las listas" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="744" width="450" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="0" y="820" width="450" height="300" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;GestorSesiones.fxml&lt;/b&gt; — Horario semanal de una clase: clic en un hueco para añadir, editar o quitar (mínimo una franja)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="1124" width="450" height="40" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="500" y="820" width="450" height="300" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;GestorCliente.fxml&lt;/b&gt; — Gestión de clientes: alta, baja, edición y foto" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="1124" width="450" height="40" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1000" y="820" width="450" height="300" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;GestorMonitor.fxml&lt;/b&gt; — Gestión de monitores: alta, baja, edición y foto" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1124" width="450" height="40" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;imageAspect=1;aspect=fixed;imageBorder=#666666;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="0" y="1200" width="450" height="300" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;VisorLog.fxml&lt;/b&gt; — Visor del log de operaciones (gerente): filtro y errores en rojo" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="1504" width="450" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>