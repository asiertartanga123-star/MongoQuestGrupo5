mxCell><mxCell id="c19" value="Gestionar clases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.55;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Gestionar clientes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="371" y="410"/><mxPoint x="678" y="410"/></Array></mxGeometry></mxCell><mxCell id="c21" value="Gestionar clases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="598" y="455"/><mxPoint x="442" y="455"/></Array></mxGeometry></mxCell><mxCell id="c22" value="Gestionar clientes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Ver log /&lt;br&gt;Herramientas › Ver log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2;entryX=1;entryY=0.2;dashed=1;dashPattern=1 4;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="Gestionar sesiones&lt;br&gt;(botón o clic derecho)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Título (volver)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0;entryX=0.85;entryY=1;dashed=1;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Título (volver)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="57" y="322"/></Array></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Volver según el rol&lt;/b&gt;: desde Gestión de clases y Gestión de clientes, pulsar el título vuelve al panel del gerente o al del monitor según quién haya iniciado sesión.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cerrar sesión&lt;/b&gt;: todas las pantallas salvo Login y Registro tienen el botón «cerrar sesión», que lleva siempre a Login.&lt;br&gt;&lt;br&gt;&lt;b&gt;Menús&lt;/b&gt;: en los paneles del gerente y del monitor, el menú «Gestión» lleva a las mismas pantallas que sus botones; «Sesión › Cerrar sesión» vuelve a Login y «Ayuda › Acerca de» abre un diálogo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Visor del log&lt;/b&gt; (solo gerente) se abre en otra ventana, sin cerrar el panel (línea de puntos).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ver más clases&lt;/b&gt; (panel del cliente) y los formularios de alta abren diálogos sobre la misma pantalla, no otra vista." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="300" height="300" as="geometry"/></mxCell><mxCell id="c28" value="Leyenda: azul = acceso · naranja = cliente · verde = paneles de trabajadores · morado = pantallas de gestión. Gris = ventana de herramientas. Línea continua = avanzar; discontinua = volver; de puntos = abre otra ventana." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="-260" y="800" width="1440" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>