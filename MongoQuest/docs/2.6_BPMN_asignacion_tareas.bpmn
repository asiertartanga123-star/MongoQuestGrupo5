    <startEvent id="Start" name="Reto asignado">
      <outgoing>Flow_01</outgoing>
    </startEvent>
    <userTask id="T_Proponer" name="Proponer casos de uso y modelo de datos">
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </userTask>
    <userTask id="T_RevisarProp" name="Revisar la propuesta">
      <incoming>Flow_02</incoming>
      <incoming>Flow_05</incoming>
      <outgoing>Flow_03</outgoing>
    </userTask>
    <exclusiveGateway id="G_Aprobada" name="¿Propuesta aprobada?">
      <incoming>Flow_03</incoming>
      <outgoing>Flow_04</outgoing>
      <outgoing>Flow_06</outgoing>
    </exclusiveGateway>
    <userTask id="T_Ajustar" name="Ajustar la propuesta">
      <incoming>Flow_04</incoming>
      <outgoing>Flow_05</outgoing>
    </userTask>
    <userTask id="T_CrearOdoo" name="Crear el proyecto y sus tareas en Odoo">
      <incoming>Flow_06</incoming>
      <outgoing>Flow_07</outgoing>
    </userTask>
    <userTask id="T_Asignar" name="Asignar una tarea a un desarrollador">
      <incoming>Flow_07</incoming>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_08</outgoing>
    </userTask>
    <userTask id="T_Desarrollar" name="Desarrollar la tarea y subirla a GitHub">
      <incoming>Flow_08</incoming>
      <outgoing>Flow_09</outgoing>
    </userTask>
    <userTask id="T_EnRevision" name="Pasar la tarea a «En revisión» en Odoo">
      <incoming>Flow_09</incoming>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_10</outgoing>
    </userTask>
    <userTask id="T_RevisarTarea" name="Revisar la tarea">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </userTask>
    <exclusiveGateway id="G_Correcta" name="¿Tarea correcta?">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>
    <userTask id="T_Corregir" name="Corregir según los comentarios">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
    </userTask>
    <userTask id="T_Hecho" name="Marcar la tarea como «Hecho»">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
    </userTask>
    <exclusiveGateway id="G_Quedan" name="¿Quedan tareas?">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <outgoing>Flow_17</outgoing>
    </exclusiveGateway>
    <userTask id="T_Entregar" name="Entregar el proyecto">
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
    </userTask>
    <userTask id="T_Evaluar" name="Evaluar el proyecto">
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
    </userTask>
    <endEvent id="End" name="Proyecto evaluado">
      <incoming>Flow_19</incoming>
    </endEvent>
