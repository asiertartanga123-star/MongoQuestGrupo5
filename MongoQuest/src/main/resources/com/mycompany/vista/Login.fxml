<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<!--
  Maqueta de 639 x 431 con posiciones absolutas (AnchorPane)
  para respetar los espacios en blanco del diseño original.
  Cambia las rutas de las imágenes por las de tu proyecto.
-->
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.controlador.LoginController"
            prefWidth="639.0" >
   <children>

      <!-- Cabecera negra -->
      <Rectangle fill="BLACK" height="81.0" width="639.0" layoutX="0.0" layoutY="0.0" />

      <!-- Logo -->
      <ImageView fitHeight="66.0" fitWidth="66.0" layoutX="13.0" layoutY="8.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../mongoquest/images/logo.png" />
         </image>
      </ImageView>

      <!-- Recuadro gris del título -->
      <Label fx:id="lblTitulo" layoutX="225.0" layoutY="25.0" prefHeight="32.0" prefWidth="190.0"
             style="-fx-background-color: #d9d9d9;" />

      <!-- Toro izquierdo -->
      <ImageView fitHeight="305.0" fitWidth="140.0" layoutX="40.0" layoutY="94.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../mongoquest/images/toro.png" />
         </image>
      </ImageView>

      <!-- Toro derecho (espejado) -->
      <ImageView fitHeight="305.0" fitWidth="140.0" layoutX="460.0" layoutY="94.0" pickOnBounds="true" preserveRatio="true" scaleX="-1.0">
         <image>
            <Image url="@../mongoquest/images/toro.png" />
         </image>
      </ImageView>

      <!-- Recuadro del login -->
      <Rectangle fill="WHITE" stroke="BLACK" strokeType="INSIDE" height="139.0" width="190.0" layoutX="225.0" layoutY="171.0" />

      <!-- Mail -->
      <Label layoutX="249.0" layoutY="193.0" text="Mail:">
         <style>-fx-font-size: 14px;</style>
      </Label>
      <TextField fx:id="txtUsuario" layoutX="326.0" layoutY="191.0" prefHeight="20.0" prefWidth="78.0"
                 style="-fx-background-color: #d9d9d9; -fx-background-radius: 12; -fx-border-color: black; -fx-border-radius: 12; -fx-padding: 0 8 0 8;" />

      <!-- Contraseña -->
      <Label layoutX="233.0" layoutY="224.0" text="Contraseña:">
         <style>-fx-font-size: 14px;</style>
      </Label>
      <PasswordField fx:id="txtPassword" layoutX="326.0" layoutY="224.0" prefHeight="20.0" prefWidth="78.0"
                     style="-fx-background-color: #d9d9d9; -fx-background-radius: 12; -fx-border-color: black; -fx-border-radius: 12; -fx-padding: 0 8 0 8;" />

      <!-- Botón iniciar sesión -->
      <Button fx:id="btnLogin" layoutX="250.0" layoutY="273.0" mnemonicParsing="false" onAction="#onIniciarSesion"
              prefHeight="22.0" prefWidth="139.0" text="Iniciar sesión"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: black; -fx-border-radius: 12; -fx-font-size: 14px; -fx-padding: 0;" />

      <!-- Registrarse -->
      <Hyperlink fx:id="linkRegistro" layoutX="279.0" layoutY="317.0" text="Registrarse"
                 style="-fx-text-fill: #0000ee; -fx-font-size: 14px; -fx-border-color: transparent; -fx-underline: false;" />
   </children>
</AnchorPane>