<BorderPane fx:id="raiz" minHeight="480.0" minWidth="760.0" prefHeight="640.0" prefWidth="900.0" style="-fx-background-color: white;" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.controlador.GestionSesionesController">

   <!-- Cabecera negra -->
