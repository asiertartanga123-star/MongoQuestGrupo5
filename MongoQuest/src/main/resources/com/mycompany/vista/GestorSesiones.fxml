<!-- Horario semanal de sesiones: lunes a sábado, de 9:00 a 23:00 (el domingo se cierra).
     Se abre desde "Gestionar sesiones" (GestionClasesController). -->

<BorderPane fx:id="raiz" minHeight="480.0" minWidth="760.0" prefHeight="640.0" prefWidth="900.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.controlador.GestionSesionesController" styleClass="fondo">

   <!-- Cabecera negra -->
   <top>
      <StackPane maxHeight="81.0" minHeight="81.0" prefHeight="81.0" styleClass="cabecera">
         <children>
            <ImageView fitHeight="66.0" fitWidth="66.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="13.0" />
               </StackPane.margin>
               <image>
                  <Image url="@../mongoquest/images/logo.png" />
               </image>
            </ImageView>

            <!-- Recuadro gris del título: el controlador pondrá el nombre de la clase -->
            <Label fx:id="lblTitulo" alignment="CENTER" maxWidth="230.0" minWidth="190.0" onMouseClicked="#onVolver" prefHeight="32.0" prefWidth="230.0" text="TOLOTOLOGYM" StackPane.alignment="CENTER" styleClass="titulo,recuadro-titulo,pulsable" />

            <!-- Círculo de usuario + cerrar sesión -->
            <HBox alignment="CENTER_RIGHT" pickOnBounds="false" spacing="12.0" StackPane.alignment="CENTER_RIGHT">
               <StackPane.margin>
                  <Insets right="13.0" />
               </StackPane.margin>
               <children>
                  <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#onCerrarSesion" text="cerrar sesion" styleClass="boton-plano" />
               </children>
            </HBox>
         </children>
      </StackPane>
   </top>

