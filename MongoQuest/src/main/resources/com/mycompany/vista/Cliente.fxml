      <StackPane maxHeight="110.0" minHeight="110.0" prefHeight="110.0" style="-fx-background-color: #333333;">
         <children>
            <ImageView fx:id="imgLogo" fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="13.0" />
               </StackPane.margin>
               <image>
                  <Image url="@../mongoquest/images/logo.png" />
               </image>
            </ImageView>

            <!-- Recuadro de en medio: nombre del gimnasio -->
            <Label fx:id="lblGimnasio" alignment="CENTER" maxWidth="270.0" minWidth="220.0" prefHeight="44.0" prefWidth="270.0" style="-fx-background-color: #e0e0e0; -fx-font-size: 20px; -fx-font-weight: bold;" text="TOLOTOLOGYM" StackPane.alignment="CENTER" />

            <HBox alignment="CENTER_RIGHT" pickOnBounds="false" spacing="12.0" StackPane.alignment="CENTER_RIGHT">
               <StackPane.margin>
                  <Insets right="13.0" />
               </StackPane.margin>
               <children>
                  <Circle fx:id="circAvatar" fill="#e0e0e0" radius="35.0" stroke="WHITE" strokeWidth="1.5" />
                  <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" prefHeight="46.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 0; -fx-font-size: 15px; -fx-text-fill: #444444;" text="cerrar sesion" />
               </children>
            </HBox>
         </children>
      </StackPane>
   </top>

